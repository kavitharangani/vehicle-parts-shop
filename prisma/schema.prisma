generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MANAGER
  CASHIER
}

enum StockTransactionType {
  PURCHASE
  SALE
  RETURN
  ADJUSTMENT
}

model User {
  id        String   @id @default(cuid()) @map("user_id")
  name      String
  username  String   @unique
  password  String
  role      UserRole @default(CASHIER)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  sales Sale[]

  @@map("users")
}

model Customer {
  id        String   @id @default(cuid()) @map("customer_id")
  name      String
  phone     String?
  address   String?
  createdAt DateTime @default(now()) @map("created_at")

  vehicles Vehicle[]
  sales    Sale[]

  @@map("customers")
}

model Supplier {
  id        String   @id @default(cuid()) @map("supplier_id")
  name      String
  phone     String?
  address   String?
  createdAt DateTime @default(now()) @map("created_at")

  parts     Part[]
  purchases Purchase[]

  @@map("suppliers")
}

model Vehicle {
  id            String   @id @default(cuid()) @map("vehicle_id")
  vehicleNumber String   @unique @map("vehicle_number")
  brand         String
  model         String
  year          Int?
  customerId    String?  @map("customer_id")
  createdAt     DateTime @default(now()) @map("created_at")

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  sales    Sale[]
  parts    Part[]

  @@map("vehicles")
}

model Category {
  id           String @id @default(cuid()) @map("category_id")
  categoryName String @unique @map("category_name")

  parts Part[]

  @@map("categories")
}

model Part {
  id                String   @id @default(cuid()) @map("part_id")
  partCode          String   @unique @map("part_code")
  partName          String   @map("part_name")
  categoryId        String?  @map("category_id")
  vehicleId         String?  @map("vehicle_id")
  compatibleVehicle String?  @map("compatible_vehicle")
  buyingPrice       Decimal  @default(0) @map("buying_price") @db.Decimal(12, 2)
  sellingPrice      Decimal  @default(0) @map("selling_price") @db.Decimal(12, 2)
  quantity          Int      @default(0)
  reorderLevel      Int      @default(5) @map("reorder_level")
  supplierId        String?  @map("supplier_id")
  createdAt         DateTime @default(now()) @map("created_at")

  category          Category?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  vehicle           Vehicle?           @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  supplier          Supplier?          @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  purchaseItems     PurchaseItem[]
  saleItems         SaleItem[]
  stockTransactions StockTransaction[]
  returnItems       SaleReturnItem[]

  @@map("parts")
}

model Purchase {
  id            String   @id @default(cuid()) @map("purchase_id")
  supplierId    String   @map("supplier_id")
  invoiceNo     String   @map("invoice_no")
  purchaseDate  DateTime @default(now()) @map("purchase_date")
  totalAmount   Decimal  @default(0) @map("total_amount") @db.Decimal(12, 2)
  paidAmount    Decimal  @default(0) @map("paid_amount") @db.Decimal(12, 2)
  balanceAmount Decimal  @default(0) @map("balance_amount") @db.Decimal(12, 2)
  createdAt     DateTime @default(now()) @map("created_at")

  supplier Supplier       @relation(fields: [supplierId], references: [id])
  items    PurchaseItem[]

  @@map("purchases")
}

model PurchaseItem {
  id         String  @id @default(cuid()) @map("purchase_item_id")
  purchaseId String  @map("purchase_id")
  partId     String  @map("part_id")
  quantity   Int
  unitPrice  Decimal @map("unit_price") @db.Decimal(12, 2)
  total      Decimal @db.Decimal(12, 2)

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  part     Part     @relation(fields: [partId], references: [id])

  @@map("purchase_items")
}

model Sale {
  id            String   @id @default(cuid()) @map("sale_id")
  invoiceNo     String   @unique @map("invoice_no")
  customerId    String?  @map("customer_id")
  vehicleId     String?  @map("vehicle_id")
  saleDate      DateTime @default(now()) @map("sale_date")
  subtotal      Decimal  @default(0) @db.Decimal(12, 2)
  discount      Decimal  @default(0) @db.Decimal(12, 2)
  grandTotal    Decimal  @default(0) @map("grand_total") @db.Decimal(12, 2)
  paidAmount    Decimal  @default(0) @map("paid_amount") @db.Decimal(12, 2)
  balanceAmount Decimal  @default(0) @map("balance_amount") @db.Decimal(12, 2)
  paymentMethod String   @default("CASH") @map("payment_method")
  userId        String   @map("user_id")
  createdAt     DateTime @default(now()) @map("created_at")

  customer Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  vehicle  Vehicle?     @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  user     User         @relation(fields: [userId], references: [id])
  items    SaleItem[]
  payments Payment[]
  returns  SaleReturn[]

  @@map("sales")
}

model SaleItem {
  id        String  @id @default(cuid()) @map("sale_item_id")
  saleId    String  @map("sale_id")
  partId    String  @map("part_id")
  quantity  Int
  unitPrice Decimal @map("unit_price") @db.Decimal(12, 2)
  discount  Decimal @default(0) @db.Decimal(12, 2)
  total     Decimal @db.Decimal(12, 2)

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  part Part @relation(fields: [partId], references: [id])

  @@map("sale_items")
}

model Payment {
  id            String   @id @default(cuid()) @map("payment_id")
  saleId        String   @map("sale_id")
  amount        Decimal  @db.Decimal(12, 2)
  paymentDate   DateTime @default(now()) @map("payment_date")
  paymentMethod String   @map("payment_method")

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model StockTransaction {
  id              String               @id @default(cuid()) @map("transaction_id")
  partId          String               @map("part_id")
  transactionType StockTransactionType @map("transaction_type")
  quantity        Int
  referenceId     String?              @map("reference_id")
  note            String?
  transactionDate DateTime             @default(now()) @map("transaction_date")

  part Part @relation(fields: [partId], references: [id])

  @@map("stock_transactions")
}

model SaleReturn {
  id          String   @id @default(cuid()) @map("return_id")
  saleId      String   @map("sale_id")
  returnDate  DateTime @default(now()) @map("return_date")
  totalAmount Decimal  @default(0) @map("total_amount") @db.Decimal(12, 2)
  reason      String?

  sale  Sale             @relation(fields: [saleId], references: [id])
  items SaleReturnItem[]

  @@map("sale_returns")
}

model SaleReturnItem {
  id       String  @id @default(cuid()) @map("return_item_id")
  returnId String  @map("return_id")
  partId   String  @map("part_id")
  quantity Int
  amount   Decimal @db.Decimal(12, 2)

  saleReturn SaleReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  part       Part       @relation(fields: [partId], references: [id])

  @@map("sale_return_items")
}
